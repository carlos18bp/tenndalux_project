{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "NODE_OPTIONS=--no-deprecation jest",
    "test:watch": "NODE_OPTIONS=--no-deprecation jest --watch",
    "test:ci": "NODE_OPTIONS=--no-deprecation jest --ci",
    "test:coverage": "NODE_OPTIONS=--no-deprecation jest --coverage && node scripts/coverage-summary.cjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:desktop": "playwright test --project='Desktop Chrome'",
    "e2e:mobile": "playwright test --project='Mobile Chrome'",
    "e2e:coverage": "playwright test",
    "e2e:clean": "rm -rf coverage-e2e",
    "check:e2e-flow-sync": "node scripts/check-flow-definitions-sync.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "axios": "^1.16.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "js-cookie": "^3.0.7",
    "lucide-react": "^0.577.0",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "swiper": "^12.1.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
